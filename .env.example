# Copie para `.env` e preencha os valores reais.
# O `.env` NÃO vai para o git (ver .gitignore).

# ---- PostgreSQL (produção) ----
POSTGRES_USER=billflux
# Senha do banco (gere uma forte, ex.: openssl rand -base64 32)
POSTGRES_PASSWORD=
POSTGRES_DB=billflux

# ---- Segurança (obrigatório em produção) ----
# Chave de sessão/CSRF:
#   python -c "import secrets; print(secrets.token_hex(32))"
BILLFLUX_SECRET_KEY=

# ---- Autenticação ----
BILLFLUX_AUTH__ALLOW_SIGNUP=false
BILLFLUX_AUTH__USERNAME=coqueiral
# Hash scrypt da senha do usuário padrão:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('sua-senha'))"
BILLFLUX_AUTH__PASSWORD_HASH=
