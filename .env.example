# Copie para `.env` e preencha os valores reais (troque "change-me").
# O `.env` NÃO vai para o git (ver .gitignore).

# ---- PostgreSQL ----
POSTGRES_USER=billflux
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billflux
# URL da API ("postgres" é o nome do serviço no compose)
BILLFLUX_DATABASE__URL=postgresql+psycopg2://billflux:change-me@postgres:5432/billflux

# ---- Segurança ----
# ATENÇÃO: a chave assina os cookies de sessão. Trocar esse valor desloga
# todo mundo na hora; mantenha estável entre restarts/deploys.
BILLFLUX_SECRET_KEY=change-me
# Cookie de sessão: a sessão dura 24h e renova a cada requisição (só expira
# após 24h sem atividade). "true" atrás de HTTPS (túnel/prod), "false" no
# http local (navegador rejeita cookie Secure em http).
BILLFLUX_SESSION_COOKIE_SECURE=false

# ---- Autenticação ----
BILLFLUX_AUTH__ALLOW_SIGNUP=false
BILLFLUX_AUTH__USERNAME=coqueiral
# Hash scrypt da senha do usuário padrão (opcional). Vazio = não cria usuário padrão.
BILLFLUX_AUTH__PASSWORD_HASH=
