# Copie este arquivo para `.env` e preencha os valores reais.
# O `.env` NÃO vai para o git (ver .gitignore).

# ---- PostgreSQL (produção) ----
POSTGRES_USER=billflux
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=billflux

# ---- Segurança (obrigatório em produção) ----
# Gere uma chave aleatória: python -c "import secrets; print(secrets.token_hex(32))"
BILLFLUX_SECRET_KEY=troque-esta-chave

# ---- Autenticação ----
BILLFLUX_AUTH__ALLOW_SIGNUP=false
BILLFLUX_AUTH__USERNAME=coqueiral
# Hash scrypt da senha do usuário padrão.
# Gere com: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('sua-senha'))"
BILLFLUX_AUTH__PASSWORD_HASH=
